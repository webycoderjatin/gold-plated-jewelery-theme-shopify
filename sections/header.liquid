<div class="header-wrapper">
  <header class="header" role="banner">
    <button class="hamburger-btn" id="hamburgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="headerNav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <div class="header-logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="logo-img" width="{{ section.settings.logo.width | at_most: 200 }}" height="{{ section.settings.logo.height | at_most: 60 }}" loading="eager" style="width: {{ section.settings.logo_width }}px; height:auto;">
        {%- else -%}
          <span class="header-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="header-right-group" style="display:flex;align-items:center;gap:0;flex:1;">
      <button class="mobile-nav-close icon-btn" id="mobileNavClose" style="display:none;position:absolute;top:16px;right:16px;z-index:210;" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <nav class="header-nav" id="headerNav" role="navigation" aria-label="Main navigation">
        {%- if section.settings.menu != blank -%}
          {%- for link in linklists[section.settings.menu].links -%}
            {%- if link.links.size > 0 -%}
              <div class="nav-item nav-item--has-sub">
                <a href="{{ link.url }}" class="nav-link{% if link.url contains 'sale' or link.title contains 'Sale' %} nav-link--sale{% endif %}">{{ link.title }}</a>
                <div class="dropdown-menu" role="menu">
                  {%- for child_link in link.links -%}<a href="{{ child_link.url }}" class="dropdown-item" role="menuitem">{{ child_link.title }}</a>{%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <div class="nav-item"><a href="{{ link.url }}" class="nav-link{% if link.url contains 'sale' or link.title contains 'Sale' %} nav-link--sale{% endif %}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="nav-item"><a href="{{ routes.root_url }}" class="nav-link">Home</a></div>
          <div class="nav-item nav-item--has-sub">
            <a href="/collections/women-jewellery" class="nav-link">Women</a>
            <div class="dropdown-menu">
              <a href="/collections/necklaces" class="dropdown-item">Necklaces</a>
              <a href="/collections/earrings" class="dropdown-item">Earrings</a>
              <a href="/collections/bracelets" class="dropdown-item">Bracelets</a>
              <a href="/collections/rings" class="dropdown-item">Rings</a>
              <a href="/collections/gift-sets" class="dropdown-item">Gift Sets</a>
            </div>
          </div>
          <div class="nav-item nav-item--has-sub">
            <a href="/collections/men" class="nav-link">Men</a>
            <div class="dropdown-menu">
              <a href="/collections/men-chains" class="dropdown-item">Chains</a>
              <a href="/collections/men-bracelets" class="dropdown-item">Bracelets & Kadas</a>
              <a href="/collections/men-rings" class="dropdown-item">Rings</a>
            </div>
          </div>
          <div class="nav-item"><a href="/collections/necklaces" class="nav-link">Necklaces</a></div>
          <div class="nav-item"><a href="/collections/earrings" class="nav-link">Earrings</a></div>
          <div class="nav-item"><a href="/collections/weddings" class="nav-link">Weddings</a></div>
          <div class="nav-item"><a href="{{ routes.collections_url }}" class="nav-link">Collections</a></div>
        {%- endif -%}
      </nav>

      <div class="header-icons">
        <button class="icon-btn" data-search-open aria-label="Search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="icon-btn" aria-label="Account"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
        {%- endif -%}
        <button class="icon-btn" data-cart-open aria-label="Cart"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><span class="cart-badge" data-cart-count hidden>0</span></button>
      </div>
    </div>
  </header>
</div>

<style>
  @media (max-width: 1024px) {
    .mobile-nav-close { display: flex !important; }
    .header-right-group { flex: unset !important; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "min": 80, "max": 300, "step": 10, "default": 160, "unit": "px", "label": "Logo width" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
