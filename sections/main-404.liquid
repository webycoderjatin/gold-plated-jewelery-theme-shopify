<section class="error-page">
  <div class="container">
    <div class="error-page__code">404</div>
    <h1 class="error-page__title">{{ 'general.404.title' | t }}</h1>
    <p class="error-page__text">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn-primary">
      {{ 'general.404.link' | t }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404 page"
}
{% endschema %}
