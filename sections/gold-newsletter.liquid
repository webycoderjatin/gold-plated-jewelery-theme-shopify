<section class="gold-newsletter">
  {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 2200 }}" alt="" loading="lazy" width="2200" height="360">{%- endif -%}
  <div class="gold-newsletter__overlay"></div>
  <div class="gold-newsletter__content">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% form 'customer', class: 'gold-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" autocomplete="email" required aria-label="Email address">
      <button type="submit">{{ section.settings.button_text }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Gold Newsletter",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join Our Inner Circle" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get exclusive offers, new arrivals and styling tips." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "SUBSCRIBE" }
  ],
  "presets": [{ "name": "Gold Newsletter" }]
}
{% endschema %}
