<section class="category-circles section--md">
  <div class="container">{%- if section.settings.heading != blank -%}<h2 class="section-heading text-center" style="margin-bottom:var(--sp-8);">{{ section.settings.heading }}</h2>{%- endif -%}</div>
  <div class="category-circles__track no-scrollbar" data-carousel>
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <a href="{%- if collection != blank -%}{{ collection.url }}{%- elsif block.settings.link != blank -%}{{ block.settings.link }}{%- else -%}{{ routes.collections_url }}{%- endif -%}" class="category-circle{% if forloop.first %} category-circle--active{% endif %}" {{ block.shopify_attributes }} aria-label="{{ block.settings.label | escape }}">
        <div class="category-circle__img-wrap">
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 240 }}" alt="{{ block.settings.label | escape }}" class="category-circle__img" width="120" height="120" loading="lazy">
          {%- elsif collection != blank and collection.featured_image != blank -%}<img src="{{ collection.featured_image | image_url: width: 240 }}" alt="{{ block.settings.label | escape }}" class="category-circle__img" width="120" height="120" loading="lazy">
          {%- elsif collection != blank and collection.products.first.featured_image != blank -%}<img src="{{ collection.products.first.featured_image | image_url: width: 240 }}" alt="{{ block.settings.label | escape }}" class="category-circle__img" width="120" height="120" loading="lazy">
          {%- else -%}<div class="category-circle__img" style="background:linear-gradient(145deg,#e9dfcc,#c4a56b);"></div>{%- endif -%}
        </div><span class="category-circle__name">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Jewelry Categories","tag":"section","class":"section-category-circles","settings":[{"type":"text","id":"heading","label":"Heading"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Category image"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"label","label":"Category name","default":"Category"},{"type":"url","id":"link","label":"Custom link"}]}],"presets":[{"name":"Jewelry Categories","blocks":[{"type":"category","settings":{"label":"Necklaces"}},{"type":"category","settings":{"label":"Earrings"}},{"type":"category","settings":{"label":"Rings"}},{"type":"category","settings":{"label":"Bracelets"}},{"type":"category","settings":{"label":"Men's Collection"}},{"type":"category","settings":{"label":"Gift Sets"}}]}]}
{% endschema %}
