<section class="brand-story{% if section.settings.bg_white %} section--bg-white{% endif %}">
  <div class="container">
    <div class="brand-story__inner">
      <div class="brand-story__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 800 }} 800w" sizes="(max-width: 768px) 100vw, 50vw" alt="{{ section.settings.heading | escape }}" class="brand-story__img" loading="lazy" width="800" height="1000">
        {%- else -%}
          <div class="brand-story__img" style="background: radial-gradient(circle at 55% 35%, #D7BA78 0, #B28A4D 22%, #EDE5D8 23%, #F7F3EB 65%);"></div>
        {%- endif -%}
      </div>

      <div class="brand-story__content">
        {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="brand-story__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="brand-story__body">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_text != blank -%}<a href="{{ section.settings.button_link | default: routes.collections_url }}" class="btn btn-outline" style="margin-top:var(--sp-6);">{{ section.settings.button_text }}</a>{%- endif -%}
        {%- if section.settings.show_newsletter -%}
          <div class="brand-story__newsletter">
            <h3 class="brand-story__newsletter-title">{{ section.settings.newsletter_title }}</h3>
            {% form 'customer', class: 'newsletter-form', data-newsletter-form: true %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" class="newsletter-input" value="{{ form.email }}" aria-required="true" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
              <button type="submit" class="newsletter-submit" name="commit" id="Subscribe">{{ 'newsletter.submit' | t }}</button>
            {% endform %}
            <p class="newsletter-success" data-newsletter-msg style="display:none; font-size:12px; margin-top:8px;"></p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gold Jewelry Story",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Gold Plated" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Everyday luxury, finished in gold." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We create gold-plated jewelry that brings a polished, elevated feel to everyday dressing. From delicate layers to bold statement pieces, each design is made to be worn, gifted and remembered.</p>" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Discover Our Jewelry" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": false },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter title", "default": "JOIN OUR INNER CIRCLE" },
    { "type": "checkbox", "id": "bg_white", "label": "Light background", "default": true }
  ],
  "presets": [{ "name": "Gold Jewelry Story" }]
}
{% endschema %}
