<section class="gold-benefits" aria-label="Why shop with us">
  <div class="gold-benefits__grid">
    {%- for block in section.blocks -%}
      <div class="gold-benefit" {{ block.shopify_attributes }}>
        <div class="gold-benefit__icon" aria-hidden="true">{{ block.settings.icon }}</div>
        <div class="gold-benefit__title">{{ block.settings.title }}</div>
        {%- if block.settings.text != blank -%}
          <div class="gold-benefit__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Gold Jewelry Benefits",
  "tag": "section",
  "class": "section-gold-benefits",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Gold Plated" },
        { "type": "text", "id": "text", "label": "Text", "default": "Made for everyday elegance" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gold Jewelry Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "✦", "title": "Premium Gold Plated", "text": "Made for everyday elegance" } },
        { "type": "benefit", "settings": { "icon": "◇", "title": "Tarnish Resistant", "text": "Carefully finished to last" } },
        { "type": "benefit", "settings": { "icon": "♡", "title": "Easy Gifting", "text": "Pieces worth giving" } },
        { "type": "benefit", "settings": { "icon": "⌁", "title": "Fast Shipping", "text": "Free over ₹999" } }
      ]
    }
  ]
}
{% endschema %}
