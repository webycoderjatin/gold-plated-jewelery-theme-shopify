<footer class="site-footer"><div class="container"><div class="footer-grid">
<div class="footer-col footer-brand"><h3 class="footer-col__title">{{ shop.name }}</h3><p class="footer-col__text">Jewelry that makes everyday brighter.</p><div class="footer-social">{%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" class="footer-social__icon" aria-label="Instagram">Instagram</a>{%- endif -%}{%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" class="footer-social__icon" aria-label="Facebook">Facebook</a>{%- endif -%}{%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" class="footer-social__icon" aria-label="YouTube">YouTube</a>{%- endif -%}</div></div>
<div class="footer-col"><h3 class="footer-col__title">{{ section.settings.menu_1_title }}</h3>{%- if section.settings.menu_1 != blank -%}<ul class="footer-menu">{%- for link in linklists[section.settings.menu_1].links -%}<li><a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}</div>
<div class="footer-col"><h3 class="footer-col__title">{{ section.settings.menu_2_title }}</h3>{%- if section.settings.menu_2 != blank -%}<ul class="footer-menu">{%- for link in linklists[section.settings.menu_2].links -%}<li><a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}</div>
<div class="footer-col"><h3 class="footer-col__title">{{ section.settings.menu_3_title }}</h3>{%- if section.settings.menu_3 != blank -%}<ul class="footer-menu">{%- for link in linklists[section.settings.menu_3].links -%}<li><a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}</div>
</div><div class="footer-bottom"><div class="footer-copyright">&copy; {{ 'now' | date: '%Y' }} Aurélie. All rights reserved.</div><div class="footer-made">Designed with ♡ for your brighter days.</div></div></div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"text","id":"menu_1_title","label":"Menu 1 heading","default":"Shop"},{"type":"link_list","id":"menu_1","label":"Shop menu","default":"footer"},{"type":"text","id":"menu_2_title","label":"Menu 2 heading","default":"Help"},{"type":"link_list","id":"menu_2","label":"Help menu","default":"footer"},{"type":"text","id":"menu_3_title","label":"Menu 3 heading","default":"About"},{"type":"link_list","id":"menu_3","label":"About menu","default":"footer"}]}{% endschema %}
