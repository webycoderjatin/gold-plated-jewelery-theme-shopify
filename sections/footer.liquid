<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Column 1: Brand Info -->
      <div class="footer-col">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" height="auto" loading="lazy" style="margin-bottom:var(--sp-4);">
        {%- else -%}
          <h3 class="footer-col__title" style="font-size:24px; font-family:var(--font-serif); font-weight:400; letter-spacing:2px; text-transform:uppercase;">{{ shop.name }}</h3>
        {%- endif -%}
        <div class="footer-col__text">
          {{ section.settings.brand_text }}
        </div>
      </div>

      <!-- Column 2: Menu 1 -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.menu_1_title }}</h3>
        {%- if section.settings.menu_1 != blank -%}
          <ul class="footer-menu">
            {%- for link in linklists[section.settings.menu_1].links -%}
              <li><a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Column 3: Menu 2 -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.menu_2_title }}</h3>
        {%- if section.settings.menu_2 != blank -%}
          <ul class="footer-menu">
            {%- for link in linklists[section.settings.menu_2].links -%}
              <li><a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Column 4: Newsletter -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.newsletter_title }}</h3>
        <p class="footer-col__text" style="font-size:12px; margin-bottom:var(--sp-2);">{{ section.settings.newsletter_text }}</p>
        
        {% form 'customer', id: 'FooterNewsletterForm', data-newsletter-form: true %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer-newsletter">
            <input
              type="email"
              name="contact[email]"
              class="footer-newsletter__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
            >
            <button type="submit" class="footer-newsletter__btn" name="commit" id="FooterSubscribe">
              {{ 'newsletter.submit' | t }}
            </button>
          </div>
          <p class="newsletter-success" data-newsletter-msg style="display:none; font-size:12px; margin-top:8px; color:var(--color-text-secondary);"></p>
        {% endform %}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-copyright">
        &copy; {{ 'now' | date: "%Y" }}, {{ shop.name | link_to: routes.root_url }}. All Rights Reserved.
      </div>
      
      {%- if section.settings.show_social -%}
        <div class="footer-social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="footer-social__icon" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="footer-social__icon" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" class="footer-social__icon" aria-label="Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="footer-social__icon" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      
      {%- if section.settings.show_payment_icons -%}
        <div class="footer-payment">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand description",
      "default": "<p>Aura Luxury Boutique<br>123 Fashion Avenue<br>New York, NY 10001<br>+1 (555) 123-4567</p>"
    },
    {
      "type": "header",
      "content": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Heading",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Menu 2"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Heading",
      "default": "Quick Links"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Heading",
      "default": "Stay Connected"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "Subscribe to receive updates, access to exclusive deals, and more."
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Edit links in Theme Settings > Social media"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
