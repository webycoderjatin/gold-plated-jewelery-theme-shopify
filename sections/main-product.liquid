<section class="product-page">
  <div class="container">
    <div class="product-layout">
      <div class="product-gallery">
        <div class="product-gallery__thumbs no-scrollbar">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ media | image_url: width: 1200 }}" width="80" height="100" loading="lazy">
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div style="position:relative;">
          {%- if product.featured_media != blank -%}
            <img id="productGalleryMain" src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.featured_media.alt | escape }}" class="product-gallery__main" width="600" height="750" loading="eager">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery__main' }}
          {%- endif -%}
        </div>
      </div>

      <div class="product-info">
        <nav class="product-info__breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          {%- if collection -%}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          {%- endif -%}
          <span>{{ product.title }}</span>
        </nav>

        <h1 class="product-info__title">{{ product.title }}</h1>

        {%- liquid
          assign current_variant = product.selected_or_first_available_variant
          assign is_sale = false
          if current_variant.compare_at_price > current_variant.price
            assign is_sale = true
          endif
        -%}
        <div class="product-info__prices">
          <span id="productPrice" class="product-info__price{% if is_sale %} product-info__price--sale{% endif %}">{{ current_variant.price | money }}</span>
          {%- if is_sale -%}
            <span id="productComparePrice" class="product-info__compare">{{ current_variant.compare_at_price | money }}</span>
            <span class="product-info__sale-badge">{{ 'products.product.sale_badge' | t }}</span>
          {%- endif -%}
        </div>

        {%- form 'product', product, id: 'productForm', data-variants: product.variants | json -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="product-variant-group">
                <span class="variant-label">{{ option.name }}</span>
                <div class="variant-options">
                  {%- for value in option.values -%}
                    <button type="button" class="variant-btn{% if option.selected_value == value %} is-selected{% endif %}" data-variant-btn data-variant-group="option{{ option.position }}" data-variant-value="{{ value | escape }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div style="margin-top:var(--sp-6); margin-bottom:var(--sp-2);">
            <span class="variant-label">{{ 'products.product.quantity.label' | t }}</span>
            <div class="product-form__qty-row">
              <div class="product-form__qty">
                <button type="button" class="product-form__qty-btn" data-qty-dec aria-label="{{ 'products.product.quantity.decrease' | t }}">−</button>
                <input type="number" name="quantity" value="1" min="1" class="product-form__qty-input" data-qty-input>
                <button type="button" class="product-form__qty-btn" data-qty-inc aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
              </div>
              <button type="submit" class="product-form__atc" data-atc-btn data-label="{{ 'products.product.add_to_cart' | t }}" {% unless current_variant.available %}disabled{% endunless %}>
                {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              </button>
            </div>
            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        {%- endform -%}

        <div style="display:flex; gap:var(--sp-6); margin-top:var(--sp-2);">
          <button type="button" class="btn btn-outline" data-wishlist-btn="{{ product.id }}" style="flex:1; border:none; padding:var(--sp-2) 0; font-size:10px; border-bottom:1px solid currentColor;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            {{ 'wishlist.add' | t }}
          </button>
        </div>

        <div class="product-accordions" style="margin-top:var(--sp-8);">
          <div class="accordion-item is-open">
            <button class="accordion-trigger" aria-expanded="true">
              {{ 'products.product.description' | t }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="accordion-content">{{ product.description | default: '<p>Experience luxury craftsmanship with this exquisite piece.</p>' }}</div>
          </div>
          {%- if section.settings.shipping_info != blank -%}
            <div class="accordion-item">
              <button class="accordion-trigger" aria-expanded="false">
                {{ 'products.product.shipping_returns' | t }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="accordion-content">{{ section.settings.shipping_info }}</div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Layout",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true },
    { "type": "richtext", "id": "shipping_info", "label": "Shipping & Returns Info", "default": "<p>Free shipping on all North American orders over $150. Returns accepted within 14 days of delivery. Custom pieces are non-refundable.</p>" }
  ]
}
{% endschema %}
