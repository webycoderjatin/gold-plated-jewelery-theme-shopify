<section class="cart-page">
  <div class="container">
    {%- if cart.item_count > 0 -%}
      <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>
      
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-page__grid">
          
          <div class="cart-page__items">
            {%- for item in cart.items -%}
              <div class="cart-page__item">
                <a href="{{ item.url }}">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" class="cart-page__item-img" alt="{{ item.title | escape }}" loading="lazy" width="100" height="125">
                  {%- else -%}
                    <div class="cart-page__item-img" style="background:var(--color-bg-light);"></div>
                  {%- endif -%}
                </a>
                
                <div class="cart-page__item-details">
                  <div>
                    <a href="{{ item.url }}" class="cart-page__item-name">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-page__item-variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                  </div>
                  
                  <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div class="qty-selector">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | minus: 1 }}" class="qty-btn" aria-label="Decrease">−</a>
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" class="qty-display" style="border:none; text-align:center; background:transparent; width:32px;">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | plus: 1 }}" class="qty-btn" aria-label="Increase">+</a>
                    </div>
                    
                    <div style="text-align:right;">
                      <p class="cart-page__item-price">{{ item.final_line_price | money }}</p>
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" class="cart-item__remove">{{ 'cart.remove' | t }}</a>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
          
          <div class="cart-page__summary">
            <h2 class="cart-page__summary-title">Order Summary</h2>
            <div class="cart-page__summary-row">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-page__summary-row">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>
            
            <div class="cart-page__summary-total">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            
            <button type="submit" name="checkout" class="btn btn-primary" style="width:100%; padding:14px; font-size:12px; margin-bottom:var(--sp-4);">
              {{ 'cart.checkout' | t }}
            </button>
            <p style="text-align:center; font-size:11px; color:var(--color-text-secondary);">{{ 'cart.free_shipping_notice' | t }}</p>
          </div>
          
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <h1 class="cart-empty__title">{{ 'cart.empty' | t }}</h1>
        <p class="cart-empty__text">Looks like you haven't added anything to your cart yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart page"
}
{% endschema %}
